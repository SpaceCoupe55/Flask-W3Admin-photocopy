{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["cdg1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{public/**,instance/**,.venv/**,**/__pycache__/**,**/*.scss}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
